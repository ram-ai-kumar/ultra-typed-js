{
  "name": "@ultratyped/lit",
  "version": "1.0.0",
  "description": "Lit adapter for UltraTyped — typing animation / typewriter",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c && node ../../scripts/cts-types.js"
  },
  "peerDependencies": {
    "lit": "^2.0.0 || ^3.0.0"
  },
  "dependencies": {
    "ultratyped": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "typing",
    "animation",
    "lit",
    "web-components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ram-ai-kumar/ultra-typed-js.git",
    "directory": "packages/lit"
  },
  "homepage": "https://github.com/ram-ai-kumar/ultra-typed-js#readme",
  "bugs": {
    "url": "https://github.com/ram-ai-kumar/ultra-typed-js/issues"
  },
  "author": "ram-ai-kumar",
  "license": "MIT"
}
