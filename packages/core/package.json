{
  "name": "ultratyped",
  "version": "1.0.0",
  "description": "Ultra-fast <2KB typing animation library — drop-in replacement for Typed.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c && cp src/index.d.ts dist/index.d.ts && node ../../scripts/cts-types.js",
    "size": "gzip-size dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "typing",
    "animation",
    "typewriter",
    "effect",
    "typed.js",
    "typewriter-effect",
    "text animation",
    "cursor",
    "animated text",
    "hero text",
    "typing effect",
    "landing page",
    "react",
    "vue",
    "svelte",
    "angular"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ram-ai-kumar/ultra-typed-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ram-ai-kumar/ultra-typed-js#readme",
  "bugs": {
    "url": "https://github.com/ram-ai-kumar/ultra-typed-js/issues"
  },
  "author": "ram-ai-kumar",
  "license": "MIT"
}
