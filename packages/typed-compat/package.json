{
  "name": "@ultratyped/typed-compat",
  "version": "0.1.0",
  "description": "Typed.js v2 compatibility shim for UltraTyped.js - drop-in replacement with zero behavior changes",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "typed.js",
    "typed",
    "typewriter",
    "typing",
    "animation",
    "text",
    "cursor",
    "compat",
    "compatibility",
    "shim",
    "drop-in",
    "replacement",
    "migration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ram-ai-kumar/ultra-typed-js.git",
    "directory": "packages/typed-compat"
  },
  "homepage": "https://github.com/ram-ai-kumar/ultra-typed-js#readme",
  "bugs": {
    "url": "https://github.com/ram-ai-kumar/ultra-typed-js/issues"
  },
  "author": "ram-ai-kumar",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "build": "rollup -c && cp src/index.d.ts dist/index.d.ts && node ../../scripts/cts-types.js"
  },
  "dependencies": {
    "ultratyped": "workspace:*"
  }
}
